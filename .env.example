# Configurações de Segurança do Jarvis Nexus Hub
NEXUS_API_KEY=sua_chave_secreta_aqui_para_autenticacao_dos_nos

# Provedor de Inteligência Artificial e TTS
# Respostas e resumo de memória usam o roteador de IA (ominiroute), sem Gemini.
LLM_PROVIDER=ominiroute
# OmniRoute local: endpoint OpenAI-compatible em http://localhost:20128/v1.
# Em Docker use o hostname do servidor OmniRoute (ex.: http://omniroute:20128/v1).
# Chave é opcional em localhost; obrigatória para qualquer host remoto HTTPS.
LLM_ROUTER_API_KEY=
LLM_ROUTER_BASE_URL=http://localhost:20128/v1
# auto/chat delega a escolha do modelo ao OmniRoute; veja /v1/models para IDs fixos.
LLM_ROUTER_MODEL=auto/chat
# Opcionais: modelos reservas (CSV), metadados não secretos e allowlist de hosts (CSV)
LLM_ROUTER_FALLBACK_MODELS=
LLM_ROUTER_HTTP_REFERER=https://seu-dominio.example
LLM_ROUTER_X_TITLE=JARVIS
LLM_ROUTER_ALLOWED_HOSTS=localhost

ELEVENLABS_API_KEY=seu_token_elevenlabs_aqui
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Origens adicionais permitidas, separadas por vírgula (opcional).
ALLOWED_ORIGINS=

# Caminhos de Persistência no Servidor
OBSIDIAN_VAULT_PATH=/data/obsidian_vault
MEMORY_DB_PATH=/data/memory/jarvis_memory.db
TZ=America/Sao_Paulo
