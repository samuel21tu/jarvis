# Configurações de Segurança do Jarvis Nexus Hub
NEXUS_API_KEY=sua_chave_secreta_aqui_para_autenticacao_dos_nos

# Provedores de Inteligência Artificial e TTS
# O código atual usa Gemini. OpenRouter fica preparado para rollout futuro.
LLM_PROVIDER=gemini
GEMINI_API_KEY=seu_token_google_gemini_aqui
OPENROUTER_API_KEY=preencher_no_servidor_fora_do_repositorio
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=definir_modelo_da_allowlist_no_servidor
# Metadados opcionais, não secretos, enviados ao OpenRouter.
OPENROUTER_HTTP_REFERER=https://seu-dominio.example
OPENROUTER_X_TITLE=JARVIS

ELEVENLABS_API_KEY=seu_token_elevenlabs_aqui
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Origens adicionais permitidas, separadas por vírgula (opcional).
ALLOWED_ORIGINS=

# Caminhos de Persistência no Servidor
OBSIDIAN_VAULT_PATH=/data/obsidian_vault
MEMORY_DB_PATH=/data/memory/jarvis_memory.db
TZ=America/Sao_Paulo
